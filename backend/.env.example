# --- Server ---------------------------------------------------------------
PORT=4000
# Comma-separated list of allowed dashboard origins. One "*" wildcard is allowed,
# e.g. http://localhost:3000,https://sme-responder.vercel.app,https://sme-responder-*.vercel.app
FRONTEND_ORIGIN=http://localhost:3000
# Shows the "Simulate Attack" endpoints. Set to false in production.
DEMO_MODE=true

# --- Sensor agent auth ------------------------------------------------------
# Must match AGENT_SHARED_SECRET in the agent's environment.
AGENT_SHARED_SECRET=dev-agent-secret

# --- Gemini (optional: without a key the chat uses playbook text) -----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Gemini 3+ thinking level: low | medium | high (leave empty for model default)
GEMINI_THINKING_LEVEL=low
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TIMEOUT_MS=12000

# --- Firebase Realtime Database ---------------------------------------------
# Optional locally (live updates fall back to SSE). REQUIRED on Vercel.
FIREBASE_DATABASE_URL=
# Service-account key. Use ONE of these three options:
#  A) the key file as base64 (or raw JSON)
FIREBASE_SERVICE_ACCOUNT_JSON=
#  B) three values copied out of the key file (private key may keep its \n characters)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
#  C) local only: path to the downloaded key file
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_STATE_PATH=sme/status
FIREBASE_HISTORY_PATH=sme/history
